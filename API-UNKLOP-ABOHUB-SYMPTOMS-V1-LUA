Players.PlayerRemoving:Connect(function(player)
    if espDrawings[player] then
        if espDrawings[player].Name then espDrawings[player].Name:Remove() end
        if espDrawings[player].Health then espDrawings[player].Health:Remove() end
        if espDrawings[player].Box then espDrawings[player].Box:Remove() end
        espDrawings[player] = nil
    end
end)

RunService.RenderStepped:Connect(function()
    pcall(function()
        if ESPEnabled then
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") then
                    local char = player.Character
                    local rootPart = char.HumanoidRootPart
                    local humanoid = char.Humanoid
                    local _, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
                    
                    if onScreen then
                        local dist = math.floor((Camera.CFrame.Position - rootPart.Position).Magnitude)
                        local health = math.floor(humanoid.Health)
                        local maxHealth = math.floor(humanoid.MaxHealth)
                        
                        if not espDrawings[player] then
                            local nameText = Drawing.new("Text")
                            nameText.Center = true
                            nameText.Outline = true
                            nameText.Font = Drawing.Fonts.UI
                            nameText.Size = 16

                            local healthText = Drawing.new("Text")
                            healthText.Center = true
                            healthText.Outline = true
                            healthText.Font = Drawing.Fonts.UI
                            healthText.Size = 14

                            local box = Drawing.new("Square")
                            box.Thickness = 1
                            box.Filled = false

                            espDrawings[player] = {Name = nameText, Health = healthText, Box = box}
                        end
                        
                        local drawings = espDrawings[player]
                        
                        local cf, size = char:GetBoundingBox()
                        local topPos, topOnScreen = Camera:WorldToViewportPoint((cf * CFrame.new(0, size.Y / 2, 0)).Position)
                        local bottomPos, bottomOnScreen = Camera:WorldToViewportPoint((cf * CFrame.new(0, -size.Y / 2, 0)).Position)
                        
                        if topOnScreen or bottomOnScreen then
                            local height = math.abs(topPos.Y - bottomPos.Y)
                            local width = height / 2

                            if ESPNameEnabled then
                                drawings.Name.Text = string.format("ชื่อ: %s [%dm]", player.Name, dist)
                                drawings.Name.Color = _G.ESPNameColor
                                drawings.Name.Position = Vector2.new(topPos.X, topPos.Y - 20)
                                drawings.Name.Visible = true
                            else
                                drawings.Name.Visible = false
                            end

                            if ESPBoxEnabled then
                                drawings.Box.Size = Vector2.new(width, height)
                                drawings.Box.Position = Vector2.new(topPos.X - width / 2, topPos.Y)
                                drawings.Box.Color = _G.ESPBoxColor
                                drawings.Box.Visible = true
                            else
                                drawings.Box.Visible = false
                            end

                            if ESPHealthEnabled then
                                drawings.Health.Text = string.format("เลือด: %d/%d", health, maxHealth)
                                drawings.Health.Color = _G.ESPHealthColor
                                drawings.Health.Position = Vector2.new(bottomPos.X, bottomPos.Y + 5)
                                drawings.Health.Visible = true
                            else
                                drawings.Health.Visible = false
                            end
                        else
                            drawings.Name.Visible = false
                            drawings.Box.Visible = false
                            drawings.Health.Visible = false
                        end
                    else
                        if espDrawings[player] then
                            espDrawings[player].Name.Visible = false
                            espDrawings[player].Box.Visible = false
                            espDrawings[player].Health.Visible = false
                        end
                    end
                else
                    if espDrawings[player] then
                        espDrawings[player].Name.Visible = false
                        espDrawings[player].Box.Visible = false
                        espDrawings[player].Health.Visible = false
                    end
                end
            end
        else
            for _, drawings in pairs(espDrawings) do
                if drawings.Name then drawings.Name.Visible = false end
                if drawings.Box then drawings.Box.Visible = false end
                if drawings.Health then drawings.Health.Visible = false end
            end
        end
    end)
end)

